@model List<StudentManagementSystem.Models.Student>

<h2>Students</h2>

<a asp-action="Create">Add New Student</a>

<table border="1" cellpadding="5">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Course</th>
        <th>Actions</th>
    </tr>

@foreach (var student in Model)
{
    <tr>
        <td>@student.Name</td>
        <td>@student.Email</td>
        <td>@student.Course</td>
        <td>
            <a asp-action="Details" asp-route-id="@student.StudentId">Details</a> |
            <a asp-action="Edit" asp-route-id="@student.StudentId">Edit</a>
        </td>
    </tr>
}
</table>
