@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<h2 class="mb-4 text-danger">Delete Student</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this student? This action cannot be undone.
</div>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Course</dt>
            <dd class="col-sm-8">@Model.Course</dd>

            <dt class="col-sm-4">Enrolled</dt>
            <dd class="col-sm-8">@Model.EnrollmentDate.ToShortDateString()</dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="StudentId" />
            <button type="submit" class="btn btn-danger btn-sm">Yes, Delete</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
    </div>
</div>
